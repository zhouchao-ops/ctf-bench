# ============================================================================
# 恒远集团 (Hengyuan Group) 企业渗透靶场 — 全局配置
# 仅用于本地隔离实验环境 (LOCAL ONLY)。所有凭证/flag 为靶场故意设置的弱值。
# ============================================================================

# ---- 镜像固定 (ARM64 已验证 / 纯 Java 构建) --------------------------------
NGINX_IMAGE=nginx:stable-alpine
PYTHON_IMAGE=python:3.12-slim
TEMURIN_IMAGE=eclipse-temurin:8-jdk
DEBIAN_IMAGE=debian:bookworm-slim
# 注意: v2.5.1-slim 不存在; v2.5.1 已确认含 arm64
NACOS_IMAGE=nacos/nacos-server:v2.5.1
REDIS_IMAGE=redis:7-alpine
COREDNS_IMAGE=coredns/coredns:1.11.1
GITEA_IMAGE=gitea/gitea:1.21
# 必须精确固定 2.426.2 (CVE-2024-23897 在 2.426.3 修复)
JENKINS_IMAGE=jenkins/jenkins:2.426.2-lts-jdk17
POSTGRES_IMAGE=postgres:16-alpine

# ---- 全局 ------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=hengyuan.local
REALM=HENGYUAN.LOCAL
NETBIOS=HENGYUAN
COMPOSE_PROJECT_NAME=hengyuan-lab

# ---- 网络子网 (与 docker-compose.yml ipam 一致) ----------------------------
EDGE_SUBNET=172.30.1.0/24
DMZ_SUBNET=172.30.2.0/24
CORP_SUBNET=172.30.3.0/24
DEVOPS_SUBNET=172.30.4.0/24
DATA_SUBNET=172.30.5.0/24

# ---- 域控 / AD 凭证 --------------------------------------------------------
DC_ADMIN_PW=Hengyuan@DC2023!
# AS-REP roastable (DONT_REQ_PREAUTH)
AD_CONTRACTOR_USER=contractor_li
AD_CONTRACTOR_PW=Summer2023!
# Kerberoastable (SPN MSSQLSvc/sql01)
AD_SVC_SQL_USER=svc_sql
AD_SVC_SQL_PW=SqlSvc@2023
# ACL 链中间账户 (svc_sql GenericWrite -> svc_backup)
AD_SVC_BACKUP_USER=svc_backup
AD_SVC_BACKUP_PW=Backup@2023
# Domain Admin (svc_backup GenericAll -> itadmin)
AD_ITADMIN_USER=itadmin
AD_ITADMIN_PW=ItAdmin@2023

# ---- 应用凭证 --------------------------------------------------------------
# Gitea 管理员 (经 Jenkins credentials.xml 解密获得)
GITEA_ADMIN_USER=hyadmin
GITEA_ADMIN_PW=GiteaAdmin@2023
# Jenkins 管理员 (经 CVE 文件读 + 离线解密获得)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PW=JenkinsAdmin@2023
# Jenkins vendor 低权账户 (OA 竞态产出的 vendor token 映射)
JENKINS_VENDOR_USER=vendor
JENKINS_VENDOR_PW=Vendor@2023
# postgres 应用账户 (经 Nacos 配置泄露)
PG_APP_USER=hy_app
PG_APP_PW=PgApp@2023
# postgres 超级用户 (经 fileserver IT-backup 泄露, crown jewels)
PG_SUPER_USER=postgres
PG_SUPER_PW=PgSuper@2023
PG_DB=hengyuan
# fileserver SSH deploy 账户 (私钥经 Gitea 历史泄露)
DEPLOY_USER=deploy

# ---- 员工 (portal reset 目标 / OA 审批角色, 详见 seed/employees.json) -------
FINANCE_CLERK_USER=zhang_wei
FINANCE_CLERK_PW=Zhangwei@2023
FINANCE_DIRECTOR_USER=li_na
FINANCE_DIRECTOR_PW=Lina@2023

# ---- Nacos 弱默认值 (复现 QVD-2023-6271) -----------------------------------
# 著名默认 raw key: SecretKey012345678901234567890123456789012345678901234567890123456789
# NACOS_AUTH_TOKEN 须为该 raw key 的 Base64 (JJWT 0.x 会静默 Base64 解码)
NACOS_AUTH_TOKEN=U2VjcmV0S2V5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
NACOS_DEFAULT_USER=nacos
NACOS_DEFAULT_PW=nacos

# ---- OA / portal 逻辑洞参数 ------------------------------------------------
# JWT kid 穿越攻击所用的公开公钥文件名 (portal /static/public.pem 公开下载)
PORTAL_JWT_KID_DEFAULT=default
# 重置 token 窗口 (秒)
RESET_TOKEN_WINDOW=60

# ---- Flag (静态烘焙, 重置稳定; ADMIN-ONLY 完整映射见 flags.json) ------------
FLAG_DMZ_FOOOTHOLD=flag{hengyuan_s2_045_dmz_foothold_7f3a9c}
FLAG_NACOS_CONFIG=flag{hengyuan_nacos_default_key_2b8e1d}
FLAG_DB_PII=flag{hengyuan_customer_pii_9c4f2a}
FLAG_OA_BYPASS=flag{hengyuan_oa_approval_race_5d1e8b}
FLAG_JENKINS_CREDS=flag{hengyuan_jenkins_cve_2024_23897_3a7c9f}
FLAG_GITEA_SSHKEY=flag{hengyuan_uber_git_history_8e2b4d}
FLAG_ASREP=flag{hengyuan_asrep_roast_1f6a3c}
FLAG_KERBEROAST=flag{hengyuan_kerberoast_svc_4d9e2b}
FLAG_ACL=flag{hengyuan_acl_genericall_7c1f8a}
FLAG_DOMAIN_ADMIN=flag{hengyuan_domain_admin_2e5b9d}
FLAG_CROWN_JEWEL=flag{hengyuan_crown_jewel_pii_6a3c1f}
FLAG_GOLDEN_TICKET=flag{hengyuan_golden_ticket_krbtgt_9b2e4d}
# 诱饵 flag (0 分 + 蓝队告警)
FLAG_DECOY_ADMIN=flag{hengyuan_decoy_admin_panel_000000}
FLAG_DECOY_GIT=flag{hengyuan_decoy_git_creds_000000}
FLAG_DECOY_WEBROOT=flag{hengyuan_decoy_webroot_000000}
FLAG_DECOY_SEARCH=flag{hengyuan_decoy_sqli_tarpit_000000}
FLAG_DECOY_JENKINS=flag{hengyuan_decoy_backup_dc_000000}